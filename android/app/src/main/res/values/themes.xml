<resources>
    <!-- Compose draws everything; the window theme only sets the background shown before the
         first frame, so it matches the app instead of flashing white or black. -->
    <style name="Theme.HabitMiner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
